# University Room Checker — Environment Configuration
# Copy this file to .env.local for local overrides.

# ============================================================
# Demo Mode Configuration
# When NEXT_PUBLIC_DEMO_MODE=true, the app runs completely standalone
# with preloaded fictional university campus data, admin/student demo logins,
# and zero external database dependencies required.
# ============================================================
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_APP_TIMEZONE=Asia/Dhaka

# ============================================================
# Optional: Supabase Production Database & Authentication
# Fill these in when connecting to a real hosted Supabase project.
# Run the database schema in `supabase/schema.sql`.
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
